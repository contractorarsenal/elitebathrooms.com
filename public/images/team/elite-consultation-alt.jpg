/*FOOTER*/
.copyright {
	display: inline-block;
	align-items: center;
  justify-content: center;
}
.copyright .dasweb-logo {
	display: inline-block;
  margin: 0 0 0 5px;
}
.copyright .dasweb-logo svg {
	  margin-left: 5px;
    margin-bottom: -5px;
    display: inline-block;
}


/*GMBR*/
.grmp-reviews-wrap .grmp-review {
    display: inline-block;
    float: none;
    vertical-align: top;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
}
.grmp-review-avatar {
    width: 50px;
    height: 50px;
}
.grmp-review-slider-container .controls li:hover {
    background:var(--e-global-color-primary);
}
.grmp-header {
    display: flex;
    margin-bottom: 1rem;
    padding: 1rem 9rem;
}
.grmp-read-more {
	font-size:12px !important;
}
.grmp-review .grmp-review-info.grmp-clearfix {
    padding: 30px 20px;
    margin-right: 0.5rem;
}
.grmp-review-avatar {
    width: 50px;
    height: 50px;
}
.grmp-review .grmp-review-info {
    margin-left: 60px;
}
.grmp-header {

    margin: 0 1rem 3rem 1rem;
    padding: 2rem 2rem;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 11px #00000017;
    -webkit-box-shadow: 0px 0px 11px 0px rgba(0, 0, 0, .09);
    -moz-box-shadow: 0px 0px 11px 0px rgba(0,0,0,.09);
}
.grmp-powered-google .grmp-powered-button {
	background-color: var(--e-global-color-primary);
    border-color: var(--e-global-color-primary);
    padding: 0.6rem 1rem;
    border-radius: 50px;
	color: #fff;
}
.grmp-powered-google .grmp-powered-button:hover {
	color:var(--e-global-color-primary);
	background:#e2e6ea;;
}

.grmp-places-reviews-wap 
.grmp-header {
    padding: 2rem 2rem;
}
.grmp-powered-google {
    margin-left: auto;
    order: 2;
    display: flex;
    flex-direction: column;
    align-items: end;
}
.grmp-glogo img {
    max-width: 117px;
    margin: 1rem;
    width: 117px;
}


/*GENERAL*/
.main-color {
	color :var(--e-global-color-primary);
}
.main-color-ng {
	background :var(--e-global-color-primary);
}

.elementor-button {
    font-family: "Figtree", Serif !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1em !important;
    padding: 10px 25px 10px 25px !important;
}
.elementor-button-default .elementor-button {
	backdrop-filter: blur(8px);
}
.col-full {
    max-width: 100%;
}
body #page .site-content {
    padding-left: 0;
    padding-right: 0;
	  margin-top: 0px;
    margin-bottom: 0px;
}
.main-navigation .sub-menu {
    min-width: 355px;
}

.elementor-widget-text-editor p a {
 color: var(--e-global-color-primary);font-weight: 700;	
}
.antra-image-gallery-masonry {
    --gallery-height: auto !important;
}    


/*QUOTE FORM*/
.quotation-form .gf_progressbar_title, .gform_required_legend {
	display:none;
}
.quotation-form .gfield_label {
	font-size:1rem;
		font-family: "Figtree", Serif !important;
	font-weight:700;
}

.quotation-form .gfield--type-image_choice .gchoice {
    min-inline-size: 32% !important;
    max-width: 48%;
}
.quotation-form .gfield--type-image_choice.gfield--image-choice-style-square .gfield-choice-image-wrapper {
    border-radius: var(--gf-field-img-choice-radius-square);
    max-width: 150px;
    margin: 0 auto;
    margin-bottom: 20px;
}
.quotation-form .gfield--type-image_choice.gfield--image-choice-appearance-card .gchoice .gform-field-label {
    font-weight: 500;
}

.quotation-form .gfield--type-choice .gchoice, .gform-theme--framework .gfield--type-choice .ginput_container_consent {
   
    background: #fff;
    padding: 15px;
    border: 1px solid #cacccf;
    border-radius: 3px;
    box-shadow: 0 0 0 rgba(18, 25, 97, 0.05), 0 2px 5px rgba(18, 25, 97, 0.1), 0 1px 1px rgba(18, 25, 97, 0.15);
}
.quotation-form .gfield--type-image_choice.gfield--image-choice-appearance-card .gchoice:where(:has(input:checked))::after {
    background-color:var(--e-global-color-primary)
			
}
.gform-theme--foundation .gform_page_footer {
	justify-content:center;
	margin-top: 3rem;
}
.quotation-form .gform_next_button.gform-theme-button.button, .quotation-form input[type="submit"]{
    padding: 15px 35px !important;
    background-color: var(--e-global-color-primary) !important;
    border-color: var(--e-global-color-primary) !important;
    font-family: 'Figtree' !important;
    font-size: 1rem !important;
    font-weight: 700 !important;
    border-radius: 50px !important;
}

.quotation-form .gform_previous_button.gform-theme-button--secondary.button {
	padding: 15px 35px !important;
    background-color: #fff !important;
    font-family: 'Figtree' !important;
    font-size: 1rem !important;
    font-weight: 700 !important;
    border-radius: 50px !important;
}

/*CITY LOOP SHORTCODE*/
.elite-tile-city-list-group {
  display: grid;
  grid-template-columns: 340px minmax(0, 1fr);
  gap: 20px 28px;
  align-items: start;
}

.elite-tile-city-list-group + .elite-tile-city-list-group {
  margin-top: 48px;
}

.elite-tile-city-list-group h3 {
  margin: 0;
  font-size: 22px;
  line-height: 1.2;
  color: #25272e;
}

.elite-tile-city-list-group ul {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 10px 12px;
  margin: 0;
  padding: 0;
}

.elite-tile-city-list-group li {
  margin: 0;
}

.elite-tile-city-list-group a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 8px 24px;
  border: 1px solid #d7dde7;
  border-radius: 999px;
  background: #ffffff;
  color: #25272e;
  font-size: 16px;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
}

.elite-tile-city-list-group a:hover {
  border-color: #b98a64;
  background: #b98a64;
  color: #ffffff;
}


@media (min-width: 1365px) and (max-width: 1470px) {
	.main-navigation ul.menu > li.menu-item > a {
		    margin: 0 0.3em;
	}
	.elementor-19 .elementor-element.elementor-element-67d26be .elementor-heading-title {
    font-size: 4rem;
	}
}


@media (min-width: 1024px) {
    .antra-image-gallery-masonry .elementor-grid .elementor-antra-item-image-gallery:nth-child(10n+1) .grid__item a img {
        height: auto;
    }
}


/*TABLETS*/
@media (max-width: 1024px) {
	
	
}


/*TABLETS VERTICAL*/
@media (max-width: 768px) {
	.elementor-element.elementor-widget.elementor-widget-site-logo {
		margin-right:130px;
	}
.quotation-form .gfield--type-choice .gchoice, .gform-theme--framework .gfield--type-choice .ginput_container_consent {
    background: #fff;
	padding: 8px;
	}
	.quotation-form .gfield--type-image_choice.gfield--image-choice-style-square .gfield-choice-image-wrapper {
    max-width: 80px;
	}
	
	  .elite-tile-city-list-group {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .elite-tile-city-list-group + .elite-tile-city-list-group {
    margin-top: 32px;
  }
	
	.quotation-form .gfield--type-image_choice .gchoice {
    min-inline-size: 48% !important;
    max-width: 48%;
}
	.elementor-element.elementor-absolute.elementor-view-default.elementor-widget.elementor-widget-icon.elementor-motion-effects-element{
	display:none;
	}
	.grmp-review .grmp-review-info.grmp-clearfix {
    padding: 25px 20px;
    margin-left: 0;
    margin-right: 0.5rem;
}
.grmp-powered-google {
        margin: 1rem 0 0 0 !important;
        text-align: center;
        align-items: center;
    }
	.grmp-places-reviews-wap .grmp-header {
    padding: 1rem 1rem;
}
	
	
}


/*MOBILE*/
@media (max-width: 480px) {
	#mobile-cta a.elementor-button {
	padding: 8px 15px !important;
		font-size: 14px !important;
}
	.elementor-element.elementor-widget.elementor-widget-site-logo {
		margin-right:30px;
	}
	.grmp-header {
    padding: 1rem 0rem;
}
	.grmp-reviews-wrap .grmp-review {
    padding-left: 1.5rem;
    padding-right: 0.5rem;
}
	.grmp-review-avatar {
		display:none;
	}
	.grmp-review .grmp-review-info {
    margin-left: 0;
}
	.footer-container,     .elementor-46 .elementor-element.elementor-element-6632dbf  {
		background-image: unset !important;
		background: #000;
	}
	
