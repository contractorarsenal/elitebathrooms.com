# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# wrangler's local-dev secret injection (see `wrangler dev` docs) -- same
# reasoning as .env* above, never committed.
.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# regenerate with `npx wrangler types` after any wrangler.jsonc binding change
worker-configuration.d.ts
/dist/
.vinext/
.wrangler/

# WordPress migration archive: large reference binaries, not source.
# reports/, data/, pages/, forms/, tracking/, seo/, scripts/, README.md stay tracked.
/wordpress-archive/html/
/wordpress-archive/media/
/wordpress-archive/screenshots/
/wordpress-archive/css/litespeed-combined/

# Local-build parity screenshots: large, regenerable via
# docs/migration/scripts/capture_all.mjs. parity-report.md stays tracked.
# The small interactions/ subfolder (6 files) is kept as direct evidence.
/docs/migration/parity-screenshots/desktop/
/docs/migration/parity-screenshots/mobile/

# Per-template WordPress-vs-rebuild visual-diff screenshot sets: same
# reasoning as parity-screenshots above — forensic comparison PNGs
# (before/after/diff/overlay), not part of the production source, large,
# and regenerable. Written findings about them stay in tracked .md docs.
/docs/migration/homepage-visual-diff/
/docs/migration/template-visual-diff/
